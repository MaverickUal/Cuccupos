# Copy this file to .env and fill in your real values. Never commit .env.
PORT=3000
# Public URL of this site (used for PayMongo success/cancel redirects)
APP_URL=http://localhost:3000

# PayMongo secret key from https://dashboard.paymongo.com/developers (use the test key while testing)
PAYMONGO_SECRET_KEY=your_paymongo_secret_key_here
# Webhook secret (shown after you create a webhook for checkout_session.payment.paid)
PAYMONGO_WEBHOOK_SECRET=your_paymongo_secret_key_here

# Firebase Admin: path to the service account JSON downloaded from
# Firebase Console > Project settings > Service accounts > Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Testing only: true = skip PayMongo and mark orders paid instantly. Must be false/absent in production.
MOCK_PAYMENTS=true
